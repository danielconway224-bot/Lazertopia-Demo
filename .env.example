# Copy this file to ".env" and paste your keys. Nothing here is required —
# with no keys at all the checkout runs in simulated mode and the demo works fine.
#
# ".env" is gitignored. Never commit real keys.

# ── Stripe (TEST MODE ONLY) ──────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/test/apikeys with the
# "Test mode" toggle ON. Both are needed before card payments switch on.
#
# The server REFUSES to start card payments if it sees a live key
# (sk_live_ / pk_live_) — this is a prototype and must never charge a real card.
#
# Secret key: starts with sk_test_ (or rk_test_ for a restricted key, which is
# the safer choice — see the README). Stays on the server, never sent to a browser.
STRIPE_SECRET_KEY=

# Publishable key: starts with pk_test_. Safe to expose — it can only start
# payments, never read or refund them.
STRIPE_PUBLISHABLE_KEY=

# ── Twilio SMS (free trial is fine) ──────────────────────────────────────
# From https://console.twilio.com — the SID and token are on the dashboard;
# the number comes from Phone Numbers → Manage → Active numbers.
#
# TRIAL LIMITS, worth knowing before you demo:
#   • A trial account can ONLY text numbers you've verified in the console
#     (Phone Numbers → Verified Caller IDs). Texting anything else fails, and
#     the Outbox will tell you exactly that.
#   • Trial texts arrive prefixed "Sent from your Twilio trial account -".
# With these blank, texts are still composed and shown in the staff Outbox,
# just marked "simulated" instead of being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── SendGrid email (Twilio company, separate free account) ────────────────
# From https://app.sendgrid.com → Settings → API Keys (needs "Mail Send").
# SENDGRID_FROM_EMAIL must be a verified sender under Settings → Sender
# Authentication, or SendGrid rejects the message.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ── Local server ─────────────────────────────────────────────────────────
# Port the dev server listens on (default 4242).
PORT=4242

# ── Not wired up yet ─────────────────────────────────────────────────────
# The database is still to come; bookings currently live in memory.
#   SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
